<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rotibalap</title>
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
    <audio id="audioPlayer" crossorigin="anonymous" preload="auto"></audio>

    <canvas id="bg-canvas"></canvas>

    <div id="loading-screen" class="loading-screen">
        <div class="loading-content">
            <div class="loader"></div>
            <div class="typing-container">
                <div class="tag-text"><span>Rotibalap</span></div>
                <div class="tag-text"><span>&lt;</span>Orang Baek<span>.</span>&gt;</div>
                <div class="tag-text"><span>&lt;</span>Hanya ingin melihat dunia menjadi lebih baik. Tanpa ada keserakahan penindasan dan monopoli<span>.</span>&gt;</div>
                <div id="start-btn" class="start-button tag-text">Tap untuk memulai</div>
            </div>
        </div>
    </div>

    <div class="container" id="content" style="display: none;">
        <div class="profile-card">
            <div class="profile-image">
                <img src="profile.png" alt="Profile" style="object-fit: cover;" />
            </div>
            <h2 id="surahName">Memuat...</h2>
            <h4 id="surahInfo">...</h4>
        </div>
        <div class="profile-card-2">
            <div id="ayahContainer" style="min-height:150px; display:flex; flex-direction:column; justify-content:center;">
                <p id="arabicText" style="text-align:right; direction:rtl; font-size:1.8rem; line-height:2; margin-bottom:10px;"></p>
                <p id="translationText" style="text-align:left; color:#ccc; font-size:1rem;"></p>
                <p id="ayahCounter" style="text-align:center; color:#888; margin-top:10px; font-size:0.9rem;"></p>
            </div>
            <br />
            <div class="links-container">
                <div style="display:flex; gap:10px; width:100%; flex-wrap:wrap;">
                    <button id="playBtn" class="nav-button" style="flex:1;"><i class="fas fa-play"></i> Putar</button>
                    <button id="pauseBtn" class="nav-button" style="flex:1;"><i class="fas fa-pause"></i> Jeda</button>
                    <button id="prevAyatBtn" class="nav-button" style="flex:1;"><i class="fas fa-arrow-left"></i> Sebelumnya</button>
                    <button id="nextAyatBtn" class="nav-button" style="flex:1;"><i class="fas fa-arrow-right"></i> Selanjutnya</button>
                </div>
                
                <select id="surahSelect" class="nav-button" style="width:100%; padding:12px; background:#ffffff15; border:1px solid #ffffff30; color:#fff; border-radius:8px; margin-top:10px;"></select>
                
                <button id="nextBtn" class="nav-button" style="margin-top:10px;">Media Sosial →</button>
            </div>
        </div>
    </div>

    <div class="container" id="content-2" style="display: none;">
        <div class="links-container">
            <a href="https://www.instagram.com/djandes15" class="link-card animate__animated animate__fadeIn" target="_blank">
                <i class="fab fa-instagram"></i><span>Instagram</span>
            </a>
            <a href="https://www.tiktok.com/@djandes15" class="link-card animate__animated animate__fadeIn" target="_blank">
                <i class="fab fa-tiktok"></i><span>TikTok</span>
            </a>
            <a href="https://t.me/rotibalap24" class="link-card animate__animated animate__fadeIn" target="_blank">
                <i class="fab fa-telegram"></i><span>Telegram</span>
            </a>
            
            <div class="profile-card">
                <div class="profile-image">
                    <img src="profile.png" alt="Profile" style="object-fit: cover;" />
                </div>
            </div>
            <button id="backBtn" class="nav-button">← Kembali</button>
        </div>
    </div>

    <script>
        // ==================== THREE.JS BACKGROUND ====================
        try {
            const canvas = document.getElementById('bg-canvas');
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);

            const particlesGeometry = new THREE.BufferGeometry();
            const particlesCount = 5000;
            const posArray = new Float32Array(particlesCount * 3);
            for (let i = 0; i < particlesCount * 3; i++) {
                posArray[i] = (Math.random() - 0.5) * 5;
            }
            particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));

            const particlesMaterial = new THREE.PointsMaterial({
                size: 0.005,
                color: '#FFFFFF',
                transparent: true,
                opacity: 0.8,
                blending: THREE.AdditiveBlending
            });

            const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
            scene.add(particlesMesh);
            camera.position.z = 2;

            let mouseX = 0, mouseY = 0;
            document.addEventListener('mousemove', (event) => {
                mouseX = event.clientX / window.innerWidth - 0.5;
                mouseY = event.clientY / window.innerHeight - 0.5;
            });

            function animate() {
                requestAnimationFrame(animate);
                particlesMesh.rotation.y += 0.001;
                particlesMesh.rotation.x += 0.001;
                camera.position.x += (mouseX * 0.5 - camera.position.x) * 0.05;
                camera.position.y += (-mouseY * 0.5 - camera.position.y) * 0.05;
                renderer.render(scene, camera);
            }
            animate();

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        } catch (error) {
            console.error('Three.js failed:', error);
            document.body.style.background = 'linear-gradient(45deg, #1a1a1a, #4a4a4a)';
        }

        // ==================== NAVIGATION ====================
        const startBtn = document.getElementById('start-btn');
        const audioPlayer = document.getElementById('audioPlayer');
        const loadingScreen = document.getElementById('loading-screen');
        const container1 = document.getElementById('content');
        const container2 = document.getElementById('content-2');

        startBtn.addEventListener('click', () => {
            loadingScreen.style.opacity = '0';
            setTimeout(() => {
                loadingScreen.style.display = 'none';
                container1.style.display = 'block';
                
                // 🔥 Acak surah untuk setiap pengunjung (1-114)
                const randomSurah = Math.floor(Math.random() * 114) + 1;
                loadSurah(randomSurah);
                
                // 🔥 Mulai dengan memutar Bismillah dulu
                setTimeout(() => {
                    playBismillahFirst();
                }, 800);
            }, 500);
        });

        document.getElementById('nextBtn').addEventListener('click', () => {
            container1.style.display = 'none';
            container2.style.display = 'block';
        });

        document.getElementById('backBtn').addEventListener('click', () => {
            container2.style.display = 'none';
            container1.style.display = 'block';
        });

        // ==================== QURAN API - PER AYAT ====================
        const surahSelect = document.getElementById('surahSelect');
        const surahName = document.getElementById('surahName');
        const surahInfo = document.getElementById('surahInfo');
        const arabicText = document.getElementById('arabicText');
        const translationText = document.getElementById('translationText');
        const ayahCounter = document.getElementById('ayahCounter');

        let currentSurahId = 1;
        let currentAyahIndex = 0;
        let totalAyahs = 0;
        let ayahData = [];
        let isPlaying = false;
        let isAutoPlay = false;
        let isBismillahPlaying = false;

        async function fetchSurahList() {
            try {
                const response = await fetch('https://api.alquran.cloud/v1/surah');
                const data = await response.json();
                const surahList = data.data;
                surahList.forEach((surah) => {
                    const option = document.createElement('option');
                    option.value = surah.number;
                    option.textContent = `${surah.number}. ${surah.englishName} (${surah.name})`;
                    surahSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Gagal mengambil daftar surah:', error);
                surahSelect.innerHTML = '<option value="1">Al-Fatihah</option>';
            }
        }

        async function loadSurah(surahId) {
            try {
                currentSurahId = surahId;
                currentAyahIndex = 0;
                isPlaying = false;
                isAutoPlay = false;
                isBismillahPlaying = false;
                
                arabicText.textContent = 'Memuat...';
                translationText.textContent = '';
                ayahCounter.textContent = '';
                audioPlayer.pause();
                audioPlayer.removeEventListener('ended', handleAyahEnd);
                audioPlayer.removeEventListener('ended', handleBismillahEnd);
                
                const [arabicRes, translationRes] = await Promise.all([
                    fetch(`https://api.alquran.cloud/v1/surah/${surahId}`),
                    fetch(`https://api.alquran.cloud/v1/surah/${surahId}/id.indonesian`)
                ]);

                const arabicData = await arabicRes.json();
                const translationData = await translationRes.json();

                const surah = arabicData.data;
                const translation = translationData.data;
                totalAyahs = surah.numberOfAyahs;

                ayahData = [];
                for (let i = 0; i < surah.ayahs.length; i++) {
                    ayahData.push({
                        arabic: surah.ayahs[i].text,
                        translation: translation.ayahs[i].text
                    });
                }

                surahName.textContent = `${surah.englishName} (${surah.name})`;
                surahInfo.textContent = `${surah.number}:1-${totalAyahs} • ${totalAyahs} Ayat`;

                showAyah(0);

            } catch (error) {
                console.error('Gagal memuat surah:', error);
                arabicText.textContent = 'Gagal memuat data. Coba lagi.';
            }
        }

        function showAyah(index) {
            if (index < 0 || index >= totalAyahs) return;
            currentAyahIndex = index;
            const ayah = ayahData[index];
            arabicText.textContent = ayah.arabic;
            translationText.textContent = `${index + 1}. ${ayah.translation}`;
            ayahCounter.textContent = `Ayat ${index + 1} dari ${totalAyahs}`;
        }

        // ============================================================
        // 🔥 FITUR: Putar Bismillah (Al-Fatihah Ayat 1) Dulu
        // ============================================================
        function playBismillahFirst() {
            isBismillahPlaying = true;
            const bismillahUrl = `https://everyayah.com/data/Alafasy_128kbps/001001.mp3`;
            
            console.log('🕌 Memutar Bismillah:', bismillahUrl);
            
            audioPlayer.src = bismillahUrl;
            audioPlayer.load();
            
            audioPlayer.removeEventListener('ended', handleBismillahEnd);
            audioPlayer.addEventListener('ended', handleBismillahEnd);
            
            audioPlayer.play().then(() => {
                console.log('✅ Bismillah berhasil diputar');
            }).catch(e => {
                console.warn('⚠️ Gagal memutar Bismillah:', e);
                isBismillahPlaying = false;
                playCurrentAyah();
            });
        }

        function handleBismillahEnd() {
            console.log('✅ Bismillah selesai, sekarang putar ayat pertama');
            isBismillahPlaying = false;
            audioPlayer.removeEventListener('ended', handleBismillahEnd);
            
            audioPlayer.removeEventListener('ended', handleAyahEnd);
            audioPlayer.addEventListener('ended', handleAyahEnd);
            playCurrentAyah();
        }
        // ============================================================

        // ============================================================
        // 🔥 PERBAIKAN AUDIO (6 Digit: Surah3digit + Ayat3digit)
        // ============================================================
        function getAyahAudioUrl(surahId, ayahNumber) {
            const surahPadded = String(surahId).padStart(3, '0');
            const ayahPadded = String(ayahNumber).padStart(3, '0');
            return `https://everyayah.com/data/Alafasy_128kbps/${surahPadded}${ayahPadded}.mp3`;
        }

        function playCurrentAyah() {
            if (currentAyahIndex >= totalAyahs) return;
            
            const surahId = currentSurahId;
            const ayahNumber = currentAyahIndex + 1;
            
            const audioUrl = getAyahAudioUrl(surahId, ayahNumber);
            
            console.log('🔄 Memutar audio surah:', audioUrl);
            
            audioPlayer.src = audioUrl;
            audioPlayer.load();
            
            audioPlayer.onerror = function() {
                console.error('❌ Error audio:', audioPlayer.error);
            };
            
            audioPlayer.play().then(() => {
                console.log('✅ Audio berhasil diputar');
                isPlaying = true;
                isAutoPlay = true;
            }).catch(e => {
                console.warn('⚠️ Gagal memutar audio:', e);
                isPlaying = false;
                isAutoPlay = false;
            });
        }

        // ============================================================
        // 🔥 FITUR BARU: Putar Surah Berikutnya (Tidak Berhenti)
        // ============================================================
        function handleAyahEnd() {
            console.log('✅ Ayat selesai, lanjut ke berikutnya');
            if (currentAyahIndex < totalAyahs - 1) {
                currentAyahIndex++;
                showAyah(currentAyahIndex);
                playCurrentAyah();
            } else {
                // 💡 BAGIAN INI DIPERBAIKI: Ketika surah selesai, putar surah baru!
                isPlaying = false;
                isAutoPlay = false;
                ayahCounter.textContent = `Selesai! Memuat surah berikutnya...`;
                console.log(' Surah selesai. Memuat surah baru secara acak...');

                // Pilih surah baru secara acak (boleh surah yang sama atau berbeda)
                const newSurah = Math.floor(Math.random() * 114) + 1;
                
                setTimeout(() => {
                    loadSurah(newSurah);
                    setTimeout(() => {
                        playBismillahFirst(); // Mulai dengan Bismillah lagi
                    }, 500);
                }, 1500); // Jeda 1,5 detik sebelum ganti surah
            }
        }
        // ============================================================

        document.getElementById('playBtn').addEventListener('click', () => {
            if (currentAyahIndex < totalAyahs) {
                console.log('🔊 Klik play manual');
                if (currentAyahIndex === 0 && !isBismillahPlaying) {
                    playBismillahFirst();
                } else {
                    playCurrentAyah();
                }
            }
        });

        document.getElementById('pauseBtn').addEventListener('click', () => {
            audioPlayer.pause();
            isPlaying = false;
            isAutoPlay = false;
            isBismillahPlaying = false;
            console.log('⏸️ Audio dijeda');
        });

        document.getElementById('prevAyatBtn').addEventListener('click', () => {
            if (currentAyahIndex > 0) {
                audioPlayer.pause();
                isPlaying = false;
                isAutoPlay = false;
                isBismillahPlaying = false;
                showAyah(currentAyahIndex - 1);
                console.log('⬅️ Pindah ke ayat sebelumnya');
            }
        });

        document.getElementById('nextAyatBtn').addEventListener('click', () => {
            if (currentAyahIndex < totalAyahs - 1) {
                audioPlayer.pause();
                isPlaying = false;
                isAutoPlay = false;
                isBismillahPlaying = false;
                showAyah(currentAyahIndex + 1);
                console.log('➡️ Pindah ke ayat berikutnya');
            }
        });

        surahSelect.addEventListener('change', function() {
            const id = parseInt(this.value);
            loadSurah(id);
            audioPlayer.pause();
            isPlaying = false;
            isAutoPlay = false;
            isBismillahPlaying = false;
            console.log('📖 Ganti surah ke:', id);
            
            setTimeout(() => {
                playBismillahFirst();
            }, 500);
        });

        fetchSurahList();

        setTimeout(() => {
            const loader = document.querySelector('.loader');
            if (loader) {
                loader.classList.add('fade-out');
            }
        }, 2500);

        console.log('✅ Web siap!');
        console.log('🔗 Test URL audio:', 'https://everyayah.com/data/Alafasy_128kbps/001001.mp3');
    </script>
</body>
</html>
